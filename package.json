{
  "name": "spending-wtf",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node server/index.mjs\" \"vite\"",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "data:expand": "python3 scripts/expand-data.py",
    "data:refresh": "python3 scripts/refresh-data.py && python3 scripts/normalize-data.py",
    "format": "prettier --write src server scripts/*.mjs tests vite.config.ts playwright.config.ts package.json",
    "mcp": "node server/mcp.mjs",
    "data:taxes": "python3 scripts/refresh-tax-data.py",
    "test:seo": "node --test tests/seo.production.mjs",
    "data:corporations": "python3 scripts/expand-corporate-data.py",
    "build:vercel": "npm run build && node scripts/prepare-vercel.mjs",
    "test:smoke": "node scripts/release-smoke.mjs",
    "test:deployment": "node --test tests/deployment.production.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vercel/analytics": "^2.0.1",
    "express": "^5.2.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": "24.x"
  }
}
